{
  "provisional": true,
  "note": "PROVISIONAL (place#325, ruling 2026-10-21): the minimal JSON-LD context for WHG's v4 Locus (/entity/locus:<PID>/) and Record (/entity/place:<pk>/) documents, until PLATO publishes the terms. It defines only the keys those documents emit. Terms are reused from Dublin Core, RDF Schema, PROV-O, schema.org and FOAF (as Linked Places does) where one fits; the rest are WHG terms under this document's own URL, described in 'terms' below. It may change without notice while provisional, so it is served with a short Cache-Control.",
  "issue": "https://github.com/WorldHistoricalGazetteer/place/issues/325",
  "terms": {
    "Locus": "A WHG locus: a permanent identifier for a recipe (a retrieval plus a clustering rule, re-run on every visit) or, for a legacy whg_id, a frozen captured membership (place#172).",
    "Record": "A WHG gazetteer record: one contributor's account of a place, not the place itself.",
    "kind": "recipe | legacy.",
    "minted": "When, by whom (only if they chose to be named) and how the locus was minted.",
    "via": "How a locus was minted: modal (a person confirmed it) or dereference (a legacy whg_id).",
    "promise": "What WHG undertakes about the identifier, the membership and the recipe.",
    "membership": "Whether the membership is stable.",
    "recipe": "The recipe itself, verbatim (a JSON literal; its canonical bytes are what the PID hashes).",
    "recipe_token": "The recipe as a URL token.",
    "current": "What the locus resolves to now (recipe) or the captured membership (legacy).",
    "frozen": "True for a legacy locus: its membership is captured, not re-run.",
    "resolved": "False when the recipe was not re-run for this document.",
    "candidates": "The record identifiers the recipe's retrieval returned now (in a cluster report: a count).",
    "candidate_total": "The retrieval's total hit count.",
    "recipe_members": "Which of the recipe's own members survive in the current retrieval.",
    "present": "Recipe members present now.",
    "absent": "Recipe members absent now.",
    "cluster_members": "The membership of the cluster the recipe selects now.",
    "cluster": "How that cluster was selected (or why clustering was skipped).",
    "withheld": "Records not shown to this viewer: a count and a reason, never enumerated.",
    "legacy": "The legacy whg_id a frozen locus was admitted from.",
    "withdrawn": "When and why a locus was withdrawn (one-way; the identifier stays).",
    "redacted": "When staff redacted a locus (the reason is not published).",
    "concordance": "The records attested to be the same place as this record, one step from it.",
    "outbound": "This record's own identity links.",
    "inbound": "Other records' links to this record.",
    "cocited": "Records citing an identifier this record also cites (listed, never aggregated).",
    "aggregates": "Whether a link counts towards the group (exactMatch/closeMatch, tiers 1-2).",
    "http_status": "Inside an error: the HTTP status the failed step answered."
  },
  "@context": {
    "@version": 1.1,
    "whg": "https://whgazetteer.org/ns/whg-context.jsonld#",
    "dct": "http://purl.org/dc/terms/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "prov": "http://www.w3.org/ns/prov#",
    "schema": "https://schema.org/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "Locus": "whg:Locus",
    "Record": "whg:Record",

    "pid": "dct:identifier",
    "identifier": "dct:identifier",
    "title": "dct:title",
    "label": "rdfs:label",
    "statement": "dct:description",
    "note": "rdfs:comment",
    "concordance_note": "rdfs:comment",
    "status": "schema:creativeWorkStatus",
    "reason": "schema:description",
    "detail": "schema:description",
    "error": {"@id": "schema:error", "@context": {"status": "whg:http_status"}},
    "count": "schema:value",
    "at": {"@id": "prov:atTime", "@type": "xsd:dateTime"},
    "resolved_at": {"@id": "prov:generatedAtTime", "@type": "xsd:dateTime"},
    "by": "dct:creator",

    "kind": "whg:kind",
    "minted": "whg:minted",
    "via": "whg:via",
    "promise": "whg:promise",
    "membership": "whg:membership",
    "recipe": {"@id": "whg:recipe", "@type": "@json"},
    "recipe_token": "whg:recipe_token",
    "recipe_page": {"@id": "foaf:page", "@type": "@id"},
    "current": "whg:current",
    "frozen": "whg:frozen",
    "resolved": "whg:resolved",
    "candidates": "whg:candidates",
    "candidate_total": "whg:candidate_total",
    "recipe_members": "whg:recipe_members",
    "present": "whg:present",
    "absent": "whg:absent",
    "cluster_members": "whg:cluster_members",
    "cluster": {"@id": "whg:cluster", "@type": "@json"},
    "withheld": "whg:withheld",
    "legacy": "whg:legacy",
    "whg_id": "whg:whg_id",
    "captured_count": "whg:captured_count",
    "members": "schema:hasPart",
    "place_id": "whg:place_id",
    "places_id": "whg:places_id",
    "captured_title": "whg:captured_title",
    "record": "whg:record",
    "entity": "whg:entity",
    "withdrawn": "whg:withdrawn",
    "redacted": "whg:redacted",

    "src_id": "whg:src_id",
    "dataset": "dct:isPartOf",
    "lpf": {"@id": "rdfs:seeAlso", "@type": "@id"},
    "lpf_access": "whg:lpf_access",
    "concordance": "whg:concordance",
    "aggregated_types": "whg:aggregated_types",
    "outbound": "whg:outbound",
    "inbound": "whg:inbound",
    "cocited": "whg:cocited",
    "truncated": {"@id": "whg:truncated", "@type": "@json"},
    "section": {"@id": "foaf:page", "@type": "@id"},
    "tier": "whg:tier",
    "link_type": "whg:link_type",
    "aggregates": "whg:aggregates",
    "provenance": "whg:provenance",
    "placeholder": "whg:placeholder",
    "target_status": "whg:target_status",
    "records": {"@id": "whg:records", "@type": "@id"},
    "cocited_identifier": "whg:cocited_identifier"
  }
}
