{# Rootless Podman on an SELinux host (see deployment/stacks/whg/README.md). Both are opt-in; unset, this renders
   exactly what it always did.
   MOUNT_LABEL=z   relabels every host bind mount (shared label, so the containers can all read the code tree).
   USERNS_WHG=keep-id:uid=1000,gid=1000   makes the host user the container's uid 1000 in the WHG-image services, so the
   checkout stays host-owned and deploy.sh can still git fetch/reset it. Leave Postgres alone: it needs a FRESH, host-owned
   data directory (it chowns it to itself); restoring existing data needs `podman unshare chown -R 999:999 <dir>`. #}
{% set MOUNT_SUFFIX = (':' ~ MOUNT_LABEL) if MOUNT_LABEL else '' %}
networks:
  {{ ENV_CONTEXT }}:
    driver: bridge
    ipam:
      config:
        - subnet: {{ SUBNET }}
{% if OLLAMA_NETWORK is defined and OLLAMA_NETWORK %}
  # Shared LLM bridge (place#211). Declared EXTERNAL in every stack so that neither `docker-compose
  # down` ever tries to remove it out from under the other stack — dev and prod both attach to it,
  # and only the prod stack runs the `ollama` service itself. server-admin/deploy.sh creates it if
  # it is missing (`docker network create {{ OLLAMA_NETWORK }}`), so a fresh host needs no manual step.
  {{ OLLAMA_NETWORK }}:
    external: true
{% endif %}

services:

  web:
    networks:
      - {{ ENV_CONTEXT }}
{% if OLLAMA_NETWORK is defined and OLLAMA_NETWORK %}
      - {{ OLLAMA_NETWORK }}          # place-name extraction reaches `http://ollama:11434` here
{% endif %}
    platform: linux/amd64
    image: {{ DOCKER_IMAGE }}:{{ DOCKER_IMAGE_TAG }}
    container_name: web_{{ ENV_CONTEXT }}_{{ BRANCH }}
{% if USERNS_WHG %}
    userns_mode: "{{ USERNS_WHG }}"
{% endif %}
    {% if MEM_LIMIT_WEB is defined %}
    mem_limit: {{ MEM_LIMIT_WEB }}
    {% endif %}
    volumes:
      - {{ BASE_DIR }}:/app{{ MOUNT_SUFFIX }}
      - {{ BASE_DIR }}/entrypoints/entrypoint-web.sh:/entrypoint.sh{{ MOUNT_SUFFIX }}
      - shared-tmp:/var/tmp
    {% if not ENV_CONTEXT == 'local' %}
      - {{ SITES_DIR }}/logs/{{ ENV_CONTEXT }}:/app/whg/logs{{ MOUNT_SUFFIX }}
      - {{ SITES_DIR }}/data_dumps:/app/data_dumps{{ MOUNT_SUFFIX }}
    {% endif %}
    env_file: {{ BASE_DIR }}/.env/.env
    environment:
      - DJANGO_SETTINGS_MODULE=whg.settings
    ports:
      - "127.0.0.1:{{ APP_PORT }}:{{ APP_PORT }}"
    user: "1000:1000"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      - redis
      - {{ DB_HOST }}
{% if ENV_CONTEXT == 'local' %}
      - webpack
{% endif %}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ APP_PORT }}/health"]
      interval: 60s
      retries: 5
      start_period: 60s
      timeout: 15s

{% if ENV_CONTEXT == 'local' %}
  webpack:
    networks:
      - {{ ENV_CONTEXT }}
    platform: linux/amd64
    image: node:18
    container_name: webpack_{{ ENV_CONTEXT }}_{{ BRANCH }}
    logging:
      driver: local
    volumes:
      - {{ BASE_DIR }}:/app{{ MOUNT_SUFFIX }}
    entrypoint: ["/app/entrypoints/entrypoint-webpack.sh"]
    restart: unless-stopped
{% endif %}

  {{ DB_HOST }}:
    networks:
      - {{ ENV_CONTEXT }}
    platform: linux/amd64
    image: postgis/postgis:15-3.4
    container_name: postgres_{{ ENV_CONTEXT }}_{{ BRANCH }}
    {% if MEM_LIMIT_DB is defined %}
    mem_limit: {{ MEM_LIMIT_DB }}
    {% endif %}
    ports:
      - "127.0.0.1:{{ DB_PORT }}:{{ DB_PORT_INTERNAL }}"
    volumes:
    {% if ENV_CONTEXT == 'local' %}
      - {{ DB_DIR }}:/var/lib/postgresql/data{{ MOUNT_SUFFIX }}
      - {{ BASE_DIR }}/entrypoints/entrypoint-postgres-local.sh:/docker-entrypoint-initdb.d/10_postgis.sh{{ MOUNT_SUFFIX }}
      - {{ BASE_DIR }}/data:/app/data{{ MOUNT_SUFFIX }}
    {% else %}
      - {{ DATABASES_DIR }}/{{ ENV_CONTEXT }}:/var/lib/postgresql/data{{ MOUNT_SUFFIX }}
    {% endif %}
      - {{ BASE_DIR }}/server-admin/restore_db_from_dump.sh:/tmp/restore_db_from_dump.sh{{ MOUNT_SUFFIX }}
      - {{ BASE_DIR }}/compose/pg_hba.conf:/etc/postgresql/pg_hba.conf{{ MOUNT_SUFFIX }}
    env_file: {{ BASE_DIR }}/.env/.env
    command: ["postgres", "-c", "hba_file=/etc/postgresql/pg_hba.conf"]
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 60s
      retries: 5
      start_period: 60s
      timeout: 15s

  redis:
    networks:
      - {{ ENV_CONTEXT }}
    platform: linux/amd64
    image: redis:bullseye
    # Redis here is only a cache + Celery broker (disposable). Disable RDB/AOF
    # persistence so a corrupt dump.rdb can never wedge startup (see 2026-06-03
    # outage). Empty --save string turns snapshotting off.
    command: ["redis-server", "--save", "", "--appendonly", "no"]
    container_name: redis_{{ ENV_CONTEXT }}_{{ BRANCH }}
    {% if MEM_LIMIT_REDIS is defined %}
    mem_limit: {{ MEM_LIMIT_REDIS }}
    {% endif %}
    ports:
      - "127.0.0.1:{{ REDIS_PORT }}:6379"
    {% if not ENV_CONTEXT == 'local' %}
    volumes:
      - {{ SITES_DIR }}/logs/{{ ENV_CONTEXT }}:/app/whg/logs{{ MOUNT_SUFFIX }}
    {% endif %}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 60s
      retries: 5
      start_period: 60s
      timeout: 15s

  celery_worker:
    networks:
      - {{ ENV_CONTEXT }}
{% if OLLAMA_NETWORK is defined and OLLAMA_NETWORK %}
      - {{ OLLAMA_NETWORK }}          # place-name extraction reaches `http://ollama:11434` here
{% endif %}
    image: {{ DOCKER_IMAGE }}:{{ DOCKER_IMAGE_TAG }}
    container_name: celery-worker_{{ ENV_CONTEXT }}_{{ BRANCH }}
{% if USERNS_WHG %}
    userns_mode: "{{ USERNS_WHG }}"
{% endif %}
    hostname: celery_worker
    {% if MEM_LIMIT_CELERY_WORKER is defined %}
    mem_limit: {{ MEM_LIMIT_CELERY_WORKER }}
    {% endif %}
    volumes:
      - {{ BASE_DIR }}:/app{{ MOUNT_SUFFIX }}
      - {{ BASE_DIR }}/entrypoints/entrypoint-celery.sh:/entrypoint.sh{{ MOUNT_SUFFIX }}
      - shared-tmp:/var/tmp
    {% if ENV_CONTEXT != 'local' %}
      - {{ SITES_DIR }}/logs/{{ ENV_CONTEXT }}:/app/whg/logs{{ MOUNT_SUFFIX }}
      - {{ SITES_DIR }}/data_dumps:/app/data_dumps{{ MOUNT_SUFFIX }}
    {% endif %}
    env_file: {{ BASE_DIR }}/.env/.env
    environment:
      - DJANGO_SETTINGS_MODULE=whg.settings
    depends_on:
      - redis
      - {{ DB_HOST }}
    restart: unless-stopped

  celery_beat:
    networks:
      - {{ ENV_CONTEXT }}
    image: {{ DOCKER_IMAGE }}:{{ DOCKER_IMAGE_TAG }}
    container_name: celery-beat_{{ ENV_CONTEXT }}_{{ BRANCH }}
{% if USERNS_WHG %}
    userns_mode: "{{ USERNS_WHG }}"
{% endif %}
    {% if MEM_LIMIT_CELERY_BEAT is defined %}
    mem_limit: {{ MEM_LIMIT_CELERY_BEAT }}
    {% endif %}
    volumes:
      - {{ BASE_DIR }}:/app{{ MOUNT_SUFFIX }}
      - {{ BASE_DIR }}/entrypoints/entrypoint-celery-beat.sh:/entrypoint.sh{{ MOUNT_SUFFIX }}
    {% if not ENV_CONTEXT == 'local' %}
      - {{ SITES_DIR }}/logs/{{ ENV_CONTEXT }}:/app/whg/logs{{ MOUNT_SUFFIX }}
      - {{ SITES_DIR }}/data_dumps:/app/data_dumps{{ MOUNT_SUFFIX }}
    {% endif %}
    env_file: {{ BASE_DIR }}/.env/.env
    environment:
      - DJANGO_SETTINGS_MODULE=whg.settings
    depends_on:
      - redis
      - {{ DB_HOST }}
    restart: unless-stopped

{% if ENABLE_FLOWER is not defined or ENABLE_FLOWER != 'False' %}
  flower:
    networks:
      - {{ ENV_CONTEXT }}
    image: {{ DOCKER_IMAGE }}:{{ DOCKER_IMAGE_TAG }}
    container_name: celery-flower_{{ ENV_CONTEXT }}_{{ BRANCH }}
{% if USERNS_WHG %}
    userns_mode: "{{ USERNS_WHG }}"
{% endif %}
    {% if MEM_LIMIT_FLOWER is defined %}
    mem_limit: {{ MEM_LIMIT_FLOWER }}
    {% endif %}
    ports:
      - "127.0.0.1:{{ FLOWER_PORT }}:5555"
    volumes:
      - {{ BASE_DIR }}:/app{{ MOUNT_SUFFIX }}
      - {{ BASE_DIR }}/entrypoints/entrypoint-flower.sh:/entrypoint.sh{{ MOUNT_SUFFIX }}
    {% if not ENV_CONTEXT == 'local' %}
      - {{ SITES_DIR }}/logs/{{ ENV_CONTEXT }}:/app/whg/logs{{ MOUNT_SUFFIX }}
      - {{ SITES_DIR }}/data_dumps:/app/data_dumps{{ MOUNT_SUFFIX }}
    {% endif %}
    env_file: {{ BASE_DIR }}/.env/.env
    environment:
      - DJANGO_SETTINGS_MODULE=whg.settings
    depends_on:
      - redis
      - {{ DB_HOST }}
    restart: unless-stopped
{% endif %}

{% if not ENV_CONTEXT == 'local' %}
  # Real-time collaboration server (Hocuspocus / Yjs — Workbench Phase 2, place#112).
  # Built on the host from ./hocuspocus; bound to 127.0.0.1 so only nginx (location /collab) reaches
  # it. Additive: if it's down, only realtime collab is affected, not the main site.
  hocuspocus:
    networks:
      - {{ ENV_CONTEXT }}
    build:
      context: {{ BASE_DIR }}/hocuspocus
    container_name: hocuspocus_{{ ENV_CONTEXT }}_{{ BRANCH }}
    {% if MEM_LIMIT_HOCUSPOCUS is defined %}
    mem_limit: {{ MEM_LIMIT_HOCUSPOCUS }}
    {% endif %}
    env_file: {{ BASE_DIR }}/.env/.env
    ports:
      - "127.0.0.1:{{ HOCUSPOCUS_PORT }}:{{ HOCUSPOCUS_PORT }}"
    depends_on:
      - {{ DB_HOST }}
    restart: unless-stopped

{% endif %}

{% if OLLAMA_HOST_CONTEXT is defined and ENV_CONTEXT == OLLAMA_HOST_CONTEXT %}
  # Local LLM host for Map-your-Data place-name extraction (place#211). Built on the host from
  # ./ollama, which seeds the model volume on first start.
  #
  # DELIBERATELY ONE INSTANCE PER HOST, and it lives here in the production stack: the model runs on
  # CPU (the droplet has no GPU) so a second copy in the dev stack would contend for the same eight
  # cores and hold a second ~600 MB of a memory-tight box. The dev stack shares this one: both stacks
  # attach `web` and `celery_worker` to the external `{{ OLLAMA_NETWORK }}` network above, so
  # `http://ollama:11434` resolves identically from either.
  #
  # Additive: if it is down or the model is missing, only place-name extraction is affected — the
  # Map-your-Data endpoint returns a friendly 503 and every other part of the site is untouched.
  ollama:
    networks:
      - {{ ENV_CONTEXT }}
{% if OLLAMA_NETWORK is defined and OLLAMA_NETWORK %}
      - {{ OLLAMA_NETWORK }}
{% endif %}
    build:
      context: {{ BASE_DIR }}/ollama
    container_name: ollama_{{ ENV_CONTEXT }}_{{ BRANCH }}
    {% if MEM_LIMIT_OLLAMA is defined %}
    mem_limit: {{ MEM_LIMIT_OLLAMA }}
    {% endif %}
    # Bound to loopback for host-side debugging (curl 127.0.0.1:{{ OLLAMA_PORT }}/api/tags); container
    # traffic goes over the docker networks above, never through this published port.
    ports:
      - "127.0.0.1:{{ OLLAMA_PORT }}:11434"
    volumes:
      - ollama-models:/root/.ollama
    env_file: {{ BASE_DIR }}/.env/.env
    environment:
      # CPU is the binding constraint here (seconds, not milliseconds, per record), so serialise: one
      # request at a time, with a bounded queue that returns 503 rather than growing without limit.
      - OLLAMA_NUM_PARALLEL=1
      - OLLAMA_MAX_QUEUE={{ OLLAMA_MAX_QUEUE }}
      - OLLAMA_MAX_LOADED_MODELS=1
      # Unload after idle so the model's RSS is not held permanently next to prod on a box that is
      # already swapping; reloading from page cache costs about a second.
      - OLLAMA_KEEP_ALIVE={{ OLLAMA_KEEP_ALIVE }}
      # Ollama's default context (4096 for qwen3:0.6b) is what actually fills this container: under a
      # sustained per-row run it sat at 1.91 GiB of anonymous memory against a 2 GiB cap, one
      # allocation from an OOM kill. WHG's extraction prompts are 150-300 tokens, so the rest was
      # allocated and never used. Raising the cap would have taken headroom from a host with 3.6 GB
      # free; sizing the context to the work costs nothing.
      - OLLAMA_CONTEXT_LENGTH={{ OLLAMA_CONTEXT_LENGTH }}
      # Ollama probes for a GPU via Vulkan, and CUDA_VISIBLE_DEVICES alone does not stop it. Confirm
      # `library=cpu` in the container log after any image bump.
      - OLLAMA_VULKAN=false
      - OLLAMA_PRELOAD={{ OLLAMA_MODEL }}
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "ollama list >/dev/null 2>&1"]
      interval: 60s
      retries: 5
      start_period: 300s
      timeout: 15s
{% endif %}

{% if TILES_DIR is defined and TILES_DIR %}
  # Static tile server for tiles.whgazetteer.org (place#335). Rendered only on a host that sets
  # TILES_DIR in env_template.py, so a host that does not run its own tile server (today's dev and
  # prod) is unaffected. It serves the MBTiles that the indexing side rsyncs into TILES_DIR; it builds
  # nothing and writes nothing: the tree is mounted read-only and the container filesystem is
  # read-only (only /tmp is writable, in memory).
  #
  # TILES_DIR has the layout the tile droplet has always had: configs/config.json, fonts/, sprites/,
  # styles/ and tiles/*.mbtiles (config.json's `options.paths.root` is `../`, i.e. TILES_DIR itself).
  # It must be owned by the deploy user; the container runs as that uid (TILESERVER_USER, default
  # 1000:1000) so no root-owned file ever appears in it and the rsync pushes keep working.
  #
  # Pinned to the same major version the tile droplet has run (4.7.0). Moving to v5 is a separate,
  # deliberate step. The port is published on loopback only; the host nginx vhost (deployment repo,
  # which carries the Origin allow-list and rate limit) is the only way in from outside.
  # TILES_MOUNT_OPTS lets a SELinux/Podman host say `ro,z`.
  tileserver:
    networks:
      - {{ ENV_CONTEXT }}
    image: {{ TILESERVER_IMAGE|default('maptiler/tileserver-gl-light') }}:{{ TILESERVER_IMAGE_TAG|default('v4.7.0') }}
    container_name: tileserver_{{ ENV_CONTEXT }}_{{ BRANCH }}
    user: "{{ TILESERVER_USER|default('1000:1000') }}"
    read_only: true
    tmpfs:
      - /tmp
    {% if MEM_LIMIT_TILESERVER is defined %}
    mem_limit: {{ MEM_LIMIT_TILESERVER }}
    {% endif %}
    command: ["--config", "/data/configs/config.json"]
    volumes:
      - {{ TILES_DIR }}:/data:{{ TILES_MOUNT_OPTS|default('ro') }}
    ports:
      - "127.0.0.1:{{ TILESERVER_PORT|default('8080') }}:8080"
    restart: unless-stopped

{% endif %}

  {% if ENV_CONTEXT == 'local' %}

  portainer:
    image: portainer/portainer-ce:latest
    container_name: portainer_{{ ENV_CONTEXT }}_{{ BRANCH }}
    networks:
      - {{ ENV_CONTEXT }}
    ports:
      - "9000:9000"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /portainer/data:/data
    restart: unless-stopped

